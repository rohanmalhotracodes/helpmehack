# Optional GitHub App credentials for higher GitHub API limits.
# The app works without them using GitHub's unauthenticated public API fallback.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=

# Optional token fallbacks.
GITHUB_TOKEN=
GITHUB_DISCOVERY_TOKEN=

# Persistent repository index in Amazon DynamoDB.
HELPMEHACK_DYNAMODB_TABLE=helpmehack-opportunity-index
# Optional when the table is in the same region as Amplify.
HELPMEHACK_DYNAMODB_REGION=

OPPORTUNITY_INDEX_TARGET=500
OPPORTUNITY_INDEX_BATCH_SIZE=24
OPPORTUNITY_INDEX_CONCURRENCY=4
OPPORTUNITY_INDEX_KEY=helpmehack:opportunity-index:v1

# Protects the scheduled refresh endpoint. Use the same value in GitHub Actions.
REFRESH_SECRET=

NEWSLETTER_ENDPOINT=
NEWSLETTER_API_TOKEN=
