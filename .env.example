# GitHub App credentials used by the server. In AWS production, store secret
# values in AWS Secrets Manager and inject them into the ECS task.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=

# Optional fallback. Public GitHub data works without authentication, but GitHub
# limits unauthenticated requests to 60 core requests per hour per originating IP.
GITHUB_TOKEN=

# Optional alternative when a GitHub App is not configured.
GITHUB_DISCOVERY_TOKEN=

# Persistent repository index. HelpMeHack uses Upstash Redis through its
# provider-neutral REST API, so the same database can be used from AWS ECS.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

OPPORTUNITY_INDEX_TARGET=500
OPPORTUNITY_INDEX_BATCH_SIZE=20
OPPORTUNITY_INDEX_CONCURRENCY=4
OPPORTUNITY_INDEX_KEY=helpmehack:opportunity-index:v1

# Store this in AWS Secrets Manager and use the same value in GitHub Actions.
REFRESH_SECRET=

NEWSLETTER_ENDPOINT=
NEWSLETTER_API_TOKEN=
