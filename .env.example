# Preferred for deployed server-to-server access. Installation tokens are
# generated on the server and automatically renewed before they expire.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=

# Optional fallback. Public GitHub data works without authentication, but GitHub
# limits unauthenticated requests to 60 core requests per hour per originating IP.
GITHUB_TOKEN=

# Optional alternative when a GitHub App is not configured. A read-only token
# raises the limit for broad public-repository discovery; it is not needed when
# the GitHub App credentials above are working.
GITHUB_DISCOVERY_TOKEN=

# Persistent repository index. Create an Upstash Redis database from the Vercel
# Marketplace and connect it to this project. These standard REST credentials
# keep indexed repository snapshots available across functions and deployments.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional aliases supported by older Vercel/Upstash integrations:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# If the Vercel resource was connected with the custom prefix
# UPSTASH_REDIS_REST, Vercel creates these longer names instead:
# UPSTASH_REDIS_REST_KV_REST_API_URL=
# UPSTASH_REDIS_REST_KV_REST_API_TOKEN=

# The daily discovery target and number of repositories enriched by each hourly
# refresh. Defaults are 500 candidates and 20 repositories per run.
OPPORTUNITY_INDEX_TARGET=500
OPPORTUNITY_INDEX_BATCH_SIZE=20
OPPORTUNITY_INDEX_CONCURRENCY=4
# Optional when multiple environments share one Redis database.
OPPORTUNITY_INDEX_KEY=helpmehack:opportunity-index:v1

# Optional. Protects the hourly refresh endpoint. Use the same value for the
# deployed REFRESH_SECRET and the GitHub Actions REFRESH_SECRET repository secret.
REFRESH_SECRET=

# Optional. A server-side webhook or API endpoint that accepts
# { "email": "...", "source": "helpmehack.com" } as JSON.
NEWSLETTER_ENDPOINT=
# Optional bearer token sent only by the server to NEWSLETTER_ENDPOINT.
NEWSLETTER_API_TOKEN=
