# Preferred for deployed server-to-server access. Installation tokens are
# generated on the server and automatically renewed before they expire.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=

# Optional fallback. Public GitHub data works without authentication, but GitHub
# limits unauthenticated requests to 60 core requests per hour per originating IP.
GITHUB_TOKEN=

# Optional. Protects the hourly refresh endpoint. Use the same value for the
# deployed REFRESH_SECRET and the GitHub Actions REFRESH_SECRET repository secret.
REFRESH_SECRET=

# Optional. A server-side webhook or API endpoint that accepts
# { "email": "...", "source": "helpmehack.com" } as JSON.
NEWSLETTER_ENDPOINT=
# Optional bearer token sent only by the server to NEWSLETTER_ENDPOINT.
NEWSLETTER_API_TOKEN=
